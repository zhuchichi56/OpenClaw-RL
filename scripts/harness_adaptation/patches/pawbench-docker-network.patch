diff --git a/pawbench/grader.py b/pawbench/grader.py
index eacc9b7..7720763 100644
--- a/pawbench/grader.py
+++ b/pawbench/grader.py
@@ -71,8 +71,12 @@ def grade_task(
     judge_model: str = DEFAULT_JUDGE_MODEL,
     judge_timeout_seconds: float = DEFAULT_JUDGE_TIMEOUT_SECONDS,
     verbose: bool = False,
+    automated_only: bool = False,
 ) -> GradeResult:
     grading_type = task.grading_type

+    if automated_only and grading_type in {"automated", "hybrid"}:
+        return _grade_automated(task, execution_result, verbose=verbose)
+
     if grading_type == "automated":
         return _grade_automated(task, execution_result, verbose=verbose)

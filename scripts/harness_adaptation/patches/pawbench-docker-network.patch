diff --git a/docker/Dockerfile.pawbench-qwenpaw b/docker/Dockerfile.pawbench-qwenpaw
index ea851eb..b80f46f 100644
--- a/docker/Dockerfile.pawbench-qwenpaw
+++ b/docker/Dockerfile.pawbench-qwenpaw
@@ -73,6 +73,11 @@ ENV COPAW_RUNNING_IN_CONTAINER=1
 # ── qwenpaw agent ─────────────────────────────────────────────────────────────
 RUN pip install --no-cache-dir "qwenpaw==${QWENPAW_VERSION}"

+# QwenPaw 1.1.3 imports SetSessionModelResponse, which was removed in
+# agent-client-protocol 0.11+. Pin the newest compatible release.
+RUN pip install --no-cache-dir "agent-client-protocol==0.10.1" && \
+    python3 -c "from qwenpaw.app._app import app; from acp import SetSessionModelResponse"
+
 # ── Common Python packages used across QwenClawBench tasks ────────────────────
 # Pre-installing these avoids per-task pip install waits and network failures.
 # Sources: requirements.txt files found in task assets across all 100 tasks.
